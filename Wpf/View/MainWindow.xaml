<Window x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <!--<ui:NavigationView>
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Dashboard"/>
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="Setting"/>
            </ui:NavigationView.FooterMenuItems>
            <ui:NavigationView.Header>
                <TextBlock Text="Header"/>
            </ui:NavigationView.Header>
        </ui:NavigationView>-->

        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <TextBlock Text="ui.ListView"/>
            <ui:ListView ItemsSource="{Binding LogList}" Margin="0, 20"/>
        </Grid>
        <Grid Grid.Row="1">
            <TextBlock Text="default.ListView"/>
            <ListBox ItemsSource="{Binding LogList}" Margin="0, 20"/>
        </Grid>
    </Grid>
</Window>
