<Window x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:converter="clr-namespace:View.Converter"
        mc:Ignorable="d"
        Title="MainWindow" Height="720" Width="1280">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="5*"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <ui:NavigationView Grid.Row="0" x:Name="RootNavigation" MenuItemsSource="{Binding Menu.MenuItems}" FooterMenuItemsSource="{Binding Menu.FooterMenuItems}" IsPaneOpen="False" IsBackButtonVisible="Collapsed">
            <ui:NavigationView.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="{Binding Session.CurrentUserId, StringFormat='welcome {0}', TargetNullValue=need login}"/>
                    <ui:Button Margin="12,0,0,0" Content="Logout" Command="{Binding LogoutCommand}" Visibility="{Binding Session.CurrentUserId, Converter={converter:NullToVisibilityConverter}}"/>
                    <ItemsControl Margin="24,0,0,0" VerticalAlignment="Center" ItemsSource="{Binding Devices.DeviceStates}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                                    <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                             Fill="{Binding IsConnected, Converter={converter:BoolToBrushConverter}}"/>
                                    <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" Text="{Binding Name}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:NavigationView.Header>
        </ui:NavigationView>
        <ui:ListView Grid.Row="1" ItemsSource="{Binding Logs}">
            <ui:ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Foreground="{Binding Level, Converter={converter:ColorFromLevelConverter}}"/>
                </DataTemplate>
            </ui:ListView.ItemTemplate>
        </ui:ListView>
    </Grid>
</Window>
